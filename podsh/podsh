#!/usr/bin/env bash
# podsh — a thin launcher for the DeepSeek Harness (dsh) with a terminal face.
# Shipped with podr; point it at any OpenAI-compatible endpoint.
#
#   podsh attach [...]      terminal face of the dsh web host (see attach.mjs)
#   podsh send   [...]      drive host sessions from any shell (see send.mjs)
#   podsh lanes             which dsh hosts are up, and what each one serves
#   podsh web    [...]      boot the dsh web host (UI at http://127.0.0.1:3080)
#   podsh "task"            headless one-shot
#
# Config (env):
#   DEEPSEEK_BASE_URL   your model endpoint, e.g. http://localhost:8000/v1
#   DEEPSEEK_API_KEY    key for that endpoint ("local" is fine for local vLLM)
#   DSH_PIN             dsh version to run (pin it — upstream is pre-1.0 and
#                       promises breaking changes; never float latest)
#
# Requires: node >= 22.15 (dsh needs node:zlib zstd), npx.

set -euo pipefail

# dsh needs node >= 22.15 (node:zlib zstd exports); fail early with a real message.
NODE_V="$(node -v 2>/dev/null | tr -d v || true)"
if [ -z "$NODE_V" ]; then
  echo "podsh: node not found — install Node.js >= 22.15" >&2; exit 1
fi
if [ "$(printf '%s\n22.15.0\n' "$NODE_V" | sort -V | head -1)" != "22.15.0" ]; then
  echo "podsh: node $NODE_V is too old — dsh needs >= 22.15 (node:zlib zstd)." >&2
  echo "podsh: set DSH_NODE_BIN or upgrade node." >&2; exit 1
fi

DSH_PIN="${DSH_PIN:-0.1.0-rc.6}"
# Optional config overlay (PODSH_PATCH, e.g. examples/ollama-cloud.patch.yml) applied to
# web/headless boots — how you point one install at a second lane.
PATCHES=()
PATCH="${PODSH_PATCH:-${EVOLV_PATCH:-}}"
[ -n "$PATCH" ] && PATCHES+=(--patch "$PATCH")
export DEEPSEEK_BASE_URL="${DEEPSEEK_BASE_URL:-http://127.0.0.1:8000/v1}"
export DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-local}"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-}" in
  attach)
    shift
    # HERDR_AGENT is podr's env-hint: the pane is identified as the `dsh`
    # agent without any screen scraping (see src/detect/manifests/dsh.toml).
    export HERDR_AGENT=dsh
    exec node "$HERE/attach.mjs" "$@"
    ;;
  send)
    shift
    exec node "$HERE/send.mjs" "$@"
    ;;
  lanes)
    shift
    exec node "$HERE/lanes-cli.mjs" "$@"
    ;;
  web)
    shift
    # Work out which port we are about to claim so we can say something useful
    # instead of letting node throw an EADDRINUSE stack at the user.
    PORT=3080
    for ((i=1; i<=$#; i++)); do
      case "${!i}" in
        --port) j=$((i+1)); PORT="${!j:-3080}" ;;
        --port=*) PORT="${!i#--port=}" ;;
      esac
    done
    if curl -sf -m 2 -X POST "http://127.0.0.1:${PORT}/api/session.list" \
         -H 'content-type: application/json' \
         -d '{"type":"client-request","rpcId":"p","method":"session.list","payload":{}}' >/dev/null 2>&1; then
      echo "podsh: a dsh host is already serving http://127.0.0.1:${PORT}" >&2
      echo "       attach to it:   podsh attach --host 127.0.0.1:${PORT}" >&2
      echo "       or start another lane on a free port:  podsh web --port $((PORT+1))" >&2
      exit 1
    fi
    if (exec 3<>/dev/tcp/127.0.0.1/"$PORT") 2>/dev/null; then
      echo "podsh: port ${PORT} is in use by something that is not a dsh host." >&2
      echo "       pick another:  podsh web --port $((PORT+1))" >&2
      exit 1
    fi
    echo "podsh: starting dsh web on http://127.0.0.1:${PORT}" >&2
    echo "podsh: first boot installs the dsh profile — minutes of silence is normal" >&2
    exec npx -y "@deepseek-ai/dsh@${DSH_PIN}" --profile web ${PATCHES[@]+"${PATCHES[@]}"} "$@"
    ;;
  ""|--help|-h)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    if [[ "$1" == -* ]]; then
      exec npx -y "@deepseek-ai/dsh@${DSH_PIN}" ${PATCHES[@]+"${PATCHES[@]}"} "$@"
    fi
    exec npx -y "@deepseek-ai/dsh@${DSH_PIN}" --profile headless ${PATCHES[@]+"${PATCHES[@]}"} "$@"
    ;;
esac
